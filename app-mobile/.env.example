# ============================================================
# 内容服务地址（Expo 会自动读取本目录下的 .env）
# 复制为 .env：cp .env.example .env
#
# 规则：
#   - 真机（iPhone + Expo Go）必须用 Mac 的「局域网 IP」，不能用 127.0.0.1
#   - 查 IP：ipconfig getifaddr en0        （或 系统设置 → Wi-Fi → 详情）
#   - 可写基础地址，也可写完整 manifest 地址（两者等价）
#   - 不填时兜底为 http://127.0.0.1:8788/manifest.json（仅 Web / iOS 模拟器可用）
#   - 最省事的方式：直接用 scripts/dev-iphone.sh，它会自动取 IP 并注入本变量
# ============================================================

# 基础地址写法（推荐）
EXPO_PUBLIC_CONTENT_URL=http://<你的局域网IP>:8788

# 完整清单地址写法（等价）
# EXPO_PUBLIC_CONTENT_URL=http://<你的局域网IP>:8788/manifest.json

# 举例：EXPO_PUBLIC_CONTENT_URL=http://172.16.95.189:8788
